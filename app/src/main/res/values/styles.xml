<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">#1B5E20</item>
        <item name="android:colorAccent">#2E7D32</item>
        <item name="android:statusBarColor">#1B5E20</item>
    </style>
    <style name="Stat">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="Tool">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:background">@drawable/bg_tool</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#1B5E20</item>
        <item name="android:textSize">22sp</item>
        <item name="android:elevation">4dp</item>
    </style>
</resources>
