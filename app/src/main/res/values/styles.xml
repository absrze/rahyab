<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:alertDialogTheme">@style/AppDialog</item>
        <item name="android:colorPrimary">#00695C</item>
        <item name="android:colorAccent">#00897B</item>
        <item name="android:statusBarColor">#0F1B24</item>
    </style>
    <style name="AppDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#00E5A0</item>
        <item name="android:windowBackground">@drawable/bg_dialog_inset</item>
    </style>
    <style name="StatLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#8FA8B5</item>
        <item name="android:textSize">11sp</item>
    </style>
    <style name="StatValue" parent="StatLabel">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textDirection">ltr</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="Column">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="Tool">
        <item name="android:layout_width">46dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:layout_marginBottom">9dp</item>
        <item name="android:background">@drawable/bg_tool</item>
        <item name="android:padding">11dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#5CF2C0</item>
        <item name="android:textSize">22sp</item>
        <item name="android:elevation">6dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="Nav">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">6dp</item>
        <item name="android:textColor">#CFE3EA</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
